# ============================================================
# 모노라마 광고 관리 시스템 - 환경변수 설정
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요.
# cp .env.example .env
# ============================================================

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=advertise
DB_USER=advertiser
DB_PASSWORD=replace_with_database_password

# ── SMTP (이메일 발송) ────────────────────────────────────
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=465
SMTP_USER=kimch@monorama.kr
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=kimch@monorama.kr
SMTP_FROM_NAME=(주)모노라마
# 이메일 첨부 파일 최대 용량 (MB)
EMAIL_MAX_ATTACH_MB=30
# 이메일 첨부 파일 최대 용량 (MB)



# ── Session / 암호화 ──────────────────────────────────────
# 충분히 긴 무작위 문자열로 변경하세요 (최소 32자)
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
# MariaDB fn_encrypt / fn_decrypt 함수의 AES 키
# schema.sql 의 SHA2() 인자와 반드시 일치해야 합니다.
ENCRYPT_KEY=AX4dQB4lzVvAzl4p
# 무활동 세션 만료 시간(초). 만료 1분 전에 연장/로그아웃 팝업 표시.
SESSION_TIMEOUT_SEC=600

# ── Supervisor 계정 ───────────────────────────────────────
SUPERVISOR_USERNAME=supervisor
SUPERVISOR_PASSWORD=sup2rv!sor
SUPERVISOR_EMAIL=kimch@monorama.kr

# ── 회사 정보 (견적서/세금계산서 표기) ────────────────────
COMPANY_NAME=(주)모노라마
COMPANY_CEO=김창호
COMPANY_BIZ_NO=277-86-00185
COMPANY_ADDRESS=서울특별시 강서구 마곡중앙로 143 B동 339호
COMPANY_BIZ_TYPE=서비스
COMPANY_BIZ_CATEGORY=컴퓨터 프로그램 개발 및 공급
COMPANY_BANK_NAME=우리은행
COMPANY_BANK_ACCOUNT=1005-802-852258
TAX_MANAGER_EMAIL=kimch@monorama.kr

# ── 서버 ────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── 광고 요금 ────────────────────────────────────────────
AD_PRICE_PER_DAY=1000
VAT_RATE=0.1
# ── LLM (Anthropic Claude) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
